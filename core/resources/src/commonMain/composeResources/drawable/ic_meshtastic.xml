      android:fillColor="#FF000000"
      android:pathData="M12,2.4 C13.5,3.3 14.05,5.2 13.9,7.1 C13.75,9.1 13.1,10.7 12,11.05 C10.9,10.7 10.25,9.1 10.1,7.1 C9.95,5.2 10.5,3.3 12,2.4 Z" />

