<!-- PANGEA BRAND MARK: solid-silhouette dinosaur footprint, derived from the
     launcher art's innermost topo contour (design/PANGEA-BRAND.md). Solid form
     rather than the contour-line rendering so it stays legible at nav-bar
     sizes. Resource keeps the upstream name for merge-friendliness; fill is
     tint-overridden by Icon(), so light/dark theming works unchanged. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

  <!-- central toe: teardrop whose base sinks into the pad (connected silhouette) -->
  <path
      android:fillColor="#FF000000"
      android:pathData="M12,2.2 C13.6,3.1 14.15,5.1 14,7.2 C13.85,9.4 13.2,11.4 12,12.8 C10.8,11.4 10.15,9.4 10,7.2 C9.85,5.1 10.4,3.1 12,2.2 Z" />

  <!-- left toe: swung out around a pivot inside the pad so the base stays merged -->
  <group
      android:rotation="-40"
      android:pivotX="12"
      android:pivotY="14.5">
    <path
        android:fillColor="#FF000000"
        android:pathData="M12,4.2 C13.4,5.0 13.85,6.7 13.72,8.5 C13.6,10.4 13.0,11.9 12,13.1 C11.0,11.9 10.4,10.4 10.28,8.5 C10.15,6.7 10.6,5.0 12,4.2 Z" />
  </group>

  <!-- right toe -->
  <group
      android:rotation="40"
      android:pivotX="12"
      android:pivotY="14.5">
    <path
        android:fillColor="#FF000000"
        android:pathData="M12,4.2 C13.4,5.0 13.85,6.7 13.72,8.5 C13.6,10.4 13.0,11.9 12,13.1 C11.0,11.9 10.4,10.4 10.28,8.5 C10.15,6.7 10.6,5.0 12,4.2 Z" />
  </group>

  <!-- pad: larger, rounded, top overlapping all three toe bases -->
  <path
      android:fillColor="#FF000000"
      android:pathData="M12,11.2 C14.7,11.2 16.3,13.0 16.3,15.3 C16.3,17.9 14.55,19.7 12,19.9 C9.45,19.7 7.7,17.9 7.7,15.3 C7.7,13.0 9.3,11.2 12,11.2 Z" />

  <!-- lateral spurs (dew claws), tucked against the pad so they merge into the print -->
  <group
      android:rotation="-58"
      android:pivotX="7.4"
      android:pivotY="14.6">
    <path
        android:fillColor="#FF000000"
        android:pathData="M7.4,12.7 C8.3,13.15 8.6,14.05 8.5,15.0 C8.42,15.9 8.05,16.6 7.4,16.8 C6.75,16.6 6.38,15.9 6.3,15.0 C6.2,14.05 6.5,13.15 7.4,12.7 Z" />
  </group>
  <group
      android:rotation="58"
      android:pivotX="16.6"
      android:pivotY="14.6">
    <path
        android:fillColor="#FF000000"
        android:pathData="M16.6,12.7 C17.5,13.15 17.8,14.05 17.7,15.0 C17.62,15.9 17.25,16.6 16.6,16.8 C15.95,16.6 15.58,15.9 15.5,15.0 C15.4,14.05 15.7,13.15 16.6,12.7 Z" />
  </group>
</vector>
