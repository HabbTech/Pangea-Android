        android:pathData="M12,4.4 C13.3,5.2 13.75,6.8 13.62,8.4 C13.5,10.1 12.95,11.4 12,11.7 C11.05,11.4 10.5,10.1 10.38,8.4 C10.25,6.8 10.7,5.2 12,4.4 Z" />
